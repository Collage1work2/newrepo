---
import { clampRating, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

{rating !== null && (
    <div class="flex items-center mb-4">
        <span
            class="inline-flex items-center gap-2 rounded-full border border-yellow-400/20 bg-slate-900/60 px-3 py-1 text-sm"
            data-testid="game-rating"
            aria-label={`Rated ${clampRating(rating).toFixed(1)} out of 5`}
        >
            <span class="text-yellow-400 tracking-wide" aria-hidden="true">{formatStarRating(rating)}</span>
            <span class="font-semibold text-slate-200">{clampRating(rating).toFixed(1)}<span class="font-normal text-slate-500">/5</span></span>
        </span>
    </div>
)}
